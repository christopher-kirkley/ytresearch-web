DATABASE_URL=sqlite:///~/music-archive/archive.db
ANTHROPIC_API_KEY=sk-ant-...
FLASK_SECRET_KEY=change-me-to-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional token for the /search endpoint (used by scripts/Automator). /search
# is localhost-only and works WITHOUT a token; set this to additionally require
# one. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SEARCH_API_TOKEN=change-me-to-random-string

# Optional: enable local downloads. OFF unless BOTH are set to existing,
# writable directories. The app never creates these directories and never
# overwrites existing files.
# DOWNLOAD_AUDIO_DIR=/path/to/music-archive/audio
# DOWNLOAD_VIDEO_DIR=/path/to/music-archive/video
# Optional: path to a local ytresearch checkout for side-by-side development.
# When set, `make run` / `make test` layer it in as an editable install,
# overriding the GitHub-pinned version. Leave unset to use GitHub (the default).
# YTRESEARCH_SRC=/path/to/ytresearch
